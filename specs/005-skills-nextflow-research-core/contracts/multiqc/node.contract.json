{
  "schema_version": "0.1",
  "component_id": "multiqc",
  "kind": "project-adapter",
  "scientific_purpose": "Aggregate bounded upstream QC evidence into a report and machine-readable artifact without turning report generation into a QC or release conclusion.",
  "hard_boundary": [
    "Does not define QC thresholds or approve scientific release",
    "Does not merge report generation with differential-expression inference",
    "Does not treat a successful process or artifact-ready verdict as a scientific claim"
  ],
  "method": {
    "name": "Project bio-multiqc wrapper around the pinned MultiQC CLI",
    "estimand_or_observable": "Observed report content, parsed module data, source mapping and fixture-derived markers",
    "unsupported_claims": [
      "A report was generated, therefore upstream QC passed",
      "A successful process is a scientific release approval",
      "The report proves downstream differential expression or biological validity"
    ]
  },
  "public_interface": {
    "takes": ["qc_input", "config", "expected_manifest"],
    "emits": ["report", "parsed_data", "verdict", "review", "provenance"]
  },
  "ports": [
    {
      "port_id": "qc_input",
      "direction": "input",
      "channel_semantics": "queue",
      "shape": "directory",
      "cardinality": "one",
      "tuple_fields": ["meta", "payload"],
      "artifact_type": "bounded upstream QC logs",
      "identity_keys": ["sample_id", "tool_id"],
      "constraints": ["directory exists", "contains at least one intended parser input", "must be outside output tree"],
      "required": true,
      "on_missing": "fail_closed"
    },
    {
      "port_id": "config",
      "direction": "input",
      "channel_semantics": "value",
      "shape": "path",
      "cardinality": "one",
      "tuple_fields": [],
      "artifact_type": "pinned MultiQC configuration",
      "identity_keys": ["config_sha256"],
      "constraints": ["file exists", "AI/network summary is disabled for sensitive data"],
      "required": true,
      "on_missing": "fail_closed"
    },
    {
      "port_id": "expected_manifest",
      "direction": "input",
      "channel_semantics": "value",
      "shape": "json",
      "cardinality": "one",
      "tuple_fields": [],
      "artifact_type": "expected sample/tool and content markers",
      "identity_keys": ["sample_id", "tool_id"],
      "constraints": ["expected markers are explicit", "does not infer a roster from discovered files"],
      "required": true,
      "on_missing": "block"
    },
    {
      "port_id": "report",
      "direction": "output",
      "channel_semantics": "queue",
      "shape": "report",
      "cardinality": "one",
      "tuple_fields": ["meta", "path"],
      "artifact_type": "HTML report",
      "identity_keys": ["sample_id", "tool_id", "run_id"],
      "constraints": ["non-empty", "contains expected fixture-derived markers"],
      "required": true,
      "on_missing": "fail_closed"
    },
    {
      "port_id": "parsed_data",
      "direction": "output",
      "channel_semantics": "queue",
      "shape": "json",
      "cardinality": "one",
      "tuple_fields": ["meta", "path"],
      "artifact_type": "MultiQC parsed data and source map",
      "identity_keys": ["sample_id", "tool_id", "run_id"],
      "constraints": ["JSON parseable", "source mapping present"],
      "required": true,
      "on_missing": "fail_closed"
    },
    {
      "port_id": "verdict",
      "direction": "output",
      "channel_semantics": "queue",
      "shape": "json",
      "cardinality": "one",
      "tuple_fields": ["meta", "path"],
      "artifact_type": "bounded execution/content verdict",
      "identity_keys": ["run_id", "input_manifest_sha256"],
      "constraints": ["execution and scientific/release status are not inferred from one another"],
      "required": true,
      "on_missing": "fail_closed"
    },
    {
      "port_id": "review",
      "direction": "output",
      "channel_semantics": "queue",
      "shape": "report",
      "cardinality": "one",
      "tuple_fields": ["meta", "path"],
      "artifact_type": "human review note",
      "identity_keys": ["run_id"],
      "constraints": ["must state that report generation is not QC approval"],
      "required": true,
      "on_missing": "block"
    },
    {
      "port_id": "provenance",
      "direction": "output",
      "channel_semantics": "queue",
      "shape": "json",
      "cardinality": "one",
      "tuple_fields": ["meta", "path"],
      "artifact_type": "input/artifact manifest and runtime metadata",
      "identity_keys": ["run_id", "input_manifest_sha256", "artifact_sha256"],
      "constraints": ["command, executable, version, parameters and hashes recorded"],
      "required": true,
      "on_missing": "fail_closed"
    }
  ],
  "routes": [
    {
      "route_id": "reporting_mode",
      "selected_by": "preset",
      "allowed_values": ["generic", "fastqc-multiqc-mvp"],
      "estimand": "Which expected parser/content checks are applied"
    },
    {
      "route_id": "execution_mode",
      "selected_by": "mode",
      "allowed_values": ["required", "skip"],
      "estimand": "Whether an actual MultiQC execution is required; skip is never release-ready"
    }
  ],
  "gates": [
    {
      "gate_id": "input_contract",
      "check": "Input directory, config, expected manifest and executable exist and input contains intended evidence",
      "on_fail": "fail_closed"
    },
    {
      "gate_id": "artifact_contract",
      "check": "HTML, parsed JSON, source map, logs, verdict and manifests exist and match fixture-derived markers",
      "on_fail": "fail_closed"
    },
    {
      "gate_id": "scientific_review",
      "check": "A human separately evaluates QC thresholds and any downstream scientific claim",
      "on_fail": "human_review"
    }
  ],
  "named_outputs": [
    {"name": "report", "port_id": "report", "stable_for_callers": true},
    {"name": "parsed_data", "port_id": "parsed_data", "stable_for_callers": true},
    {"name": "verdict", "port_id": "verdict", "stable_for_callers": true},
    {"name": "review", "port_id": "review", "stable_for_callers": true},
    {"name": "provenance", "port_id": "provenance", "stable_for_callers": true}
  ],
  "identity": {
    "key_definitions": [
      {
        "key": "run_id",
        "namespace": "research-core.run",
        "scope": "run",
        "unique_within": "case",
        "required": true
      },
      {
        "key": "sample_id",
        "namespace": "fastqc.sample",
        "scope": "sample",
        "unique_within": "run",
        "required": true
      },
      {
        "key": "tool_id",
        "namespace": "qc.tool",
        "scope": "tool",
        "unique_within": "run",
        "required": true
      },
      {
        "key": "input_manifest_sha256",
        "namespace": "sha256.manifest.input",
        "scope": "artifact",
        "unique_within": "run",
        "required": true
      },
      {
        "key": "config_sha256",
        "namespace": "sha256.configuration",
        "scope": "configuration",
        "unique_within": "run",
        "required": true
      },
      {
        "key": "artifact_sha256",
        "namespace": "sha256.artifact",
        "scope": "artifact",
        "unique_within": "run",
        "required": true
      }
    ],
    "join_cardinality": "one-to-one",
    "duplicate_policy": "fail_closed",
    "unmatched_policy": "fail_closed",
    "transport": "meta travels with payload; public outputs are named and do not depend on internal process names",
    "missing_key_behavior": "fail_closed"
  },
  "provenance": {
    "source_refs": [
      "spec-mvp/skills/multiqc/SKILL.md",
      "extensions/bio-multiqc/scripts/run_multiqc.py",
      "extensions/bio-multiqc/config/multiqc_config.yaml",
      "specs/005-skills-nextflow-research-core/evaluation/cases/multiqc-mvp/"
    ],
    "observed_at": "2026-09-02",
    "run_record_schema": "specs/005-skills-nextflow-research-core/contracts/run-status.schema.json",
    "required_run_fields": [
      "repository",
      "input_manifest",
      "artifact_manifest",
      "command",
      "executable",
      "parameters",
      "environment",
      "reference_snapshots",
      "verifier"
    ]
  },
  "evidence": [
    {"kind": "source", "ref": "spec-mvp/skills/multiqc/SKILL.md", "status": "FACT"},
    {"kind": "fixture", "ref": "tests/fixtures/multiqc/", "status": "FACT"},
    {"kind": "verifier", "ref": "specs/005-skills-nextflow-research-core/evaluation/cases/multiqc-mvp/verifier/verify_case.py", "status": "FACT"},
    {"kind": "run", "ref": "specs/005-skills-nextflow-research-core/evaluation/runs/multiqc-mvp-20260902/", "status": "FACT"},
    {"kind": "review", "ref": "specs/005-skills-nextflow-research-core/evaluation/runs/multiqc-mvp-20260902/research-core-review.md", "status": "FACT"},
    {"kind": "review", "ref": "specs/005-skills-nextflow-research-core/review/approval.md", "status": "PROPOSAL"}
  ]
}
