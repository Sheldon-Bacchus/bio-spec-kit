{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bio-spec-kit.local/specs/005-skills-nextflow-research-core/contracts/artifact-manifest.schema.json",
  "title": "Research Core repository-relative artifact manifest",
  "description": "Hashes and repository-relative identities for artifacts emitted by one local run.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "path_base", "run_root", "generated_at", "artifacts"],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "path_base": {
      "const": "repository-root"
    },
    "run_root": {
      "$ref": "#/$defs/repository_path"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "exists", "size", "sha256"],
        "properties": {
          "path": {
            "$ref": "#/$defs/repository_path"
          },
          "exists": {
            "type": "boolean"
          },
          "size": {
            "type": ["integer", "null"],
            "minimum": 0
          },
          "sha256": {
            "anyOf": [
              { "$ref": "#/$defs/sha256" },
              { "type": "null" }
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "repository_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?![\\\\/])(?!.*(?:^|/)\\.\\.(?:/|$))[^\\r\\n]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
